{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "clone",
  "redirects": [
    {
      "source": "/_next/image",
      "has": [
        {
          "type": "query",
          "key": "url",
          "value": "(?<target>.*)"
        }
      ],
      "destination": "/:target"
    }
  ],
  "rewrites": [
    {
      "source": "/_next/image",
      "has": [
        {
          "type": "query",
          "key": "url",
          "value": "(?<target>.*)"
        }
      ],
      "destination": "/:target"
    }
  ]
}
