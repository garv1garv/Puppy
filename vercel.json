{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "clone",
  "routes": [
    {
      "src": "^/_next/image\\?url=%2F([^&]+).*",
      "dest": "/$1"
    },
    {
      "src": "^/_next/image\\?url=(?:%2F)?([^&]+).*",
      "dest": "/$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
